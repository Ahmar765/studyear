# Copy to `.env` and fill in real values. Never commit `.env` or put secrets in this template.
# Restart `npm run dev` after changes.

# -----------------------------------------------------------------------------
# Firebase (client — safe to expose in the browser)
# From Firebase Console → Project settings → Your apps
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abc"
NEXT_PUBLIC_MEASUREMENT_ID="G-XXXXXXXXXX"

# -----------------------------------------------------------------------------
# Firebase Admin (server only — Firestore, Auth admin, contact form storage)
# Option A: path to service account JSON (recommended locally)
# GOOGLE_APPLICATION_CREDENTIALS="./path/to/serviceAccountKey.json"
# Option B: inline JSON (common on Vercel — paste minified one line)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Optional override if bucket name differs:
# FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"

# -----------------------------------------------------------------------------
# Google AI / Genkit (server only — do not use NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
GEMINI_API_KEY="AIza..."

# -----------------------------------------------------------------------------
# Cloudinary (images: profiles, visuals, assignment review)
# Production: signed server uploads (api secret stays server-side)
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
# CLOUDINARY_UPLOAD_PRESET="your-preset"
# Local dev: unsigned preset (browser upload)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-preset"

# -----------------------------------------------------------------------------
# Outbound email (contact form, welcome, ACU receipts)
# Required for contact form to email your inbox; submissions still save to Firestore without this.
# Hostinger example: host smtp.hostinger.com, port 465, secure true
# Use a mailbox that can SEND (e.g. noreply@); inbox for replies is set in Admin → Communications.
# -----------------------------------------------------------------------------
MAIL_SMTP_HOST="smtp.yourhost.com"
MAIL_SMTP_PORT="465"
MAIL_SMTP_SECURE="true"
MAIL_USERNAME="noreply@yourdomain.com"
MAIL_PASSWORD="your-smtp-password"
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="StudYear"

# -----------------------------------------------------------------------------
# Stripe (checkout, subscriptions, ACU top-ups)
# Dashboard → Developers → API keys; Webhooks → signing secret
# Run: npm run stripe:seed-subscription-prices (then paste price IDs below)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STUDENT_PREMIUM="price_..."
STRIPE_PRICE_STUDENT_PREMIUM_PLUS="price_..."
STRIPE_PRICE_PARENT_PRO="price_..."
STRIPE_PRICE_PARENT_PRO_PLUS="price_..."
STRIPE_PRICE_PARENT_ELITE="price_..."
STRIPE_PRICE_SCHOOL_STARTER="price_..."
STRIPE_PRICE_SCHOOL_GROWTH="price_..."
STRIPE_PRICE_SCHOOL_ENTERPRISE="price_..."

# -----------------------------------------------------------------------------
# App URL (Stripe redirect URLs; optional if VERCEL_URL is set on Vercel)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:9002"
